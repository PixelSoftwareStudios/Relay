{
  "productName": "Relay",
  "identifier": "dev.relay.relay-desktop",
  "description": "Voice calls on your local network",
  "homepage": "https://github.com/PixelSoftwareStudios/Relay",
  "authors": [
    "Relay maintainers"
  ],
  "publisher": "Relay maintainers",
  "licenseFile": "LICENSE",
  "deb": {
    "section": "sound",
    "priority": "optional",
    "depends": [
      "libc6 (>= 2.35)",
      "libgcc-s1",
      "libasound2t64 | libasound2",
      "libxkbcommon0",
      "libwayland-client0",
      "libx11-6",
      "libxcursor1",
      "libxi6",
      "libxrandr2",
      "libegl1",
      "libgl1",
      "xdg-desktop-portal"
    ]
  },
  "appimage": {
    "libs": [
      "libX11*.so.*",
      "libXcursor.so.*",
      "libXi.so.*",
      "libXrandr.so.*",
      "libxkbcommon*.so.*",
      "libwayland*.so.*",
      "libxcb*.so.*"
    ]
  }
}
