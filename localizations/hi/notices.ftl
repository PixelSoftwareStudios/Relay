# Relay desktop UI catalog, Hindi (hi), section: Notices strip.
# Same ids and $variables as localizations/en/notices.ftl. See docs/i18n.md.

notice-dismiss-all = सभी हटाएँ
notice-more = +{ $count } और
notice-fewer = कम दिखाएँ
notice-repeated = { $title } ({ $count } बार)
notice-key-changed-title = { $name } की सुरक्षा कुंजी बदल गई
notice-key-changed-title-unnamed = किसी डिवाइस की सुरक्षा कुंजी बदल गई
notice-key-changed-step = ऐसा आमतौर पर उस डिवाइस पर Relay दोबारा इंस्टॉल या रीसेट करने के बाद होता है। आप संपर्क में जाकर इसे फिर से सत्यापित कर सकते हैं।
notice-audio-restarted-title = ऑडियो कुछ पल के लिए रुका और फिर शुरू कर दिया गया।
notice-audio-restarted-step = अगर कॉल की आवाज़ ठीक न लगे, तो कॉल काटकर दोबारा करें।
notice-audio-failed-title = ऑडियो काम करना बंद हो गया और फिर शुरू नहीं हो सका।
notice-audio-failed-step = Relay को फिर से शुरू करें।
notice-mic-restarted-title = आपका माइक्रोफ़ोन रुक गया।
notice-render-restarted-title = सामने वाले का ऑडियो रुक गया।
notice-worker-restarted-step = Relay ने उसे फिर से शुरू कर दिया।
notice-output-lost-title = स्पीकर या हेडफ़ोन अलग हो गया
notice-output-lost-step = सामने वाले की आवाज़ रुकी हुई है। उसे फिर से जोड़ें या सेटिंग में कोई और आउटपुट चुनें।
notice-mic-title = माइक्रोफ़ोन उपलब्ध नहीं है
notice-mic-step = जाँचें कि Relay को उसका उपयोग करने की अनुमति है और कोई दूसरा ऐप उसे इस्तेमाल नहीं कर रहा, फिर दोबारा कोशिश करें।
notice-avatar-title = प्रोफ़ाइल तस्वीर स्वीकार नहीं की गई
notice-avatar-step = बाकी सब पर कोई असर नहीं पड़ा।
notice-prefs-recovered-title = आपकी सेटिंग ठीक कर दी गईं
notice-prefs-recovered-step = बैकअप का उपयोग किया गया। सेटिंग में अपना माइक्रोफ़ोन चुनाव जाँचें।
notice-prefs-reset-title = आपकी सेटिंग रीसेट कर दी गईं
notice-prefs-reset-step = सेटिंग में माइक्रोफ़ोन फिर से चुनें।
notice-trust-recovered-title = कुछ भरोसेमंद डिवाइस को दोबारा जाँचना पड़ सकता है
notice-trust-recovered-step = भरोसेमंद डिवाइस की सूची ठीक कर दी गई। हाल के संपर्कों को संपर्क में फिर से सत्यापित करें।
notice-trust-lost-title = भरोसेमंद डिवाइस की सूची खो गई
notice-trust-lost-step = संपर्क में हर डिवाइस को फिर से सत्यापित करें।
