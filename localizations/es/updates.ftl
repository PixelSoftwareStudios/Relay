# Relay desktop UI catalog, español (es), section: Updates: the opt-in check, the update button and its failures.
# English is the reference; a translation uses the same $variables. See docs/i18n.md.

update-heading = Actualizaciones
update-launch-label = Buscar actualizaciones al iniciar Relay
update-privacy = Relay consulta a github.com cuál es la versión más reciente. GitHub puede ver tu dirección IP y la versión de Relay que usas; no se envía nada más. Relay solo busca actualizaciones si pulsas el botón o activas esta opción.
update-check = Buscar actualizaciones
update-checking = Buscando actualizaciones…
update-up-to-date = Relay { $version } está actualizado.
update-available = Relay { $version } está disponible.
update-button = Actualizar a { $version }
update-view-release = Ver la versión
update-downloading = Descargando { $percent }%
update-verifying = Comprobando la firma…
update-installing = Instalando…
update-finish-call = Termina primero tu llamada.
update-manual-note = Esta copia de Relay no puede actualizarse sola. Usa “Ver la versión” para obtener la versión { $version }.
update-failed-offline = Relay no pudo conectar con GitHub. Revisa tu conexión a internet e inténtalo de nuevo.
update-failed-translocated = Primero mueve Relay a la carpeta Aplicaciones y vuelve a intentarlo.
update-failed-readonly = Relay se está ejecutando desde un lugar de solo lectura, como una imagen de disco. Primero muévelo a la carpeta Aplicaciones y vuelve a intentarlo.
update-failed-not-writable = Relay no puede reemplazarse donde está instalado. Muévelo a una carpeta en la que puedas escribir y vuelve a intentarlo.
update-failed-rejected = La actualización NO se instaló: Relay no pudo confirmar que realmente procede de los desarrolladores de Relay. No se cambió nada en tu dispositivo.
update-failed-damaged = La actualización NO se instaló: la descarga estaba incompleta o dañada. No se cambió nada en tu dispositivo. Inténtalo de nuevo.
update-failed-other = Algo salió mal y la actualización no se instaló. Tu versión actual sigue funcionando.
