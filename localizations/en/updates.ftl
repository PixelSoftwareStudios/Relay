# Relay desktop UI catalog, English (en), section: Updates: the opt-in check, the update button and its failures.
# English is the reference; a translation uses the same $variables. See docs/i18n.md.

update-heading = Updates
update-launch-label = Check for updates when Relay starts
update-privacy = Relay asks github.com for the newest version. GitHub can see your IP address and the Relay version you run; nothing else is sent. Relay never checks unless you press the button or turn this on.
update-check = Check for updates
update-checking = Checking for updates…
update-up-to-date = Relay { $version } is up to date.
update-available = Relay { $version } is available.
update-button = Update to { $version }
update-view-release = View release
update-downloading = Downloading { $percent }%
update-verifying = Checking signature…
update-installing = Installing…
update-finish-call = Finish your call first.
update-manual-note = This copy of Relay cannot update itself. Use View release to get version { $version }.
update-failed-offline = Relay could not reach GitHub. Check your internet connection and try again.
update-failed-translocated = Move Relay to your Applications folder first, then try again.
update-failed-readonly = Relay is running from a read-only place, such as a disk image. Move it to your Applications folder first, then try again.
update-failed-not-writable = Relay cannot replace itself where it is installed. Move it to a folder you can write to, then try again.
update-failed-rejected = The update was NOT installed: Relay could not confirm that it really comes from the Relay team. Nothing on your device was changed.
update-failed-damaged = The update was NOT installed: the download was incomplete or damaged. Nothing on your device was changed. Try again.
update-failed-other = Something went wrong, so the update was not installed. Your current version still works.
