# Relay desktop UI catalog, English (en), section: Notices strip.
# Project Fluent. English is the reference; a translation uses the same $variables. See docs/i18n.md.

notice-dismiss-all = Dismiss all
notice-more = +{ $count } more
notice-fewer = Show fewer
notice-repeated = { $title } ({ $count } times)
notice-key-changed-title = { $name }'s security key changed
notice-key-changed-title-unnamed = A device's security key changed
notice-key-changed-step = This usually happens after reinstalling or resetting Relay on that device. You can verify it again from Contacts.
notice-audio-restarted-title = Audio stopped for a moment and was restarted.
notice-audio-restarted-step = If a call sounds wrong, hang up and call again.
notice-audio-failed-title = Audio stopped working and could not be restarted.
notice-audio-failed-step = Restart Relay.
notice-mic-restarted-title = Your microphone stopped.
notice-render-restarted-title = Audio from the other side stopped.
notice-worker-restarted-step = Relay restarted it.
notice-output-lost-title = The speaker or headphones were disconnected
notice-output-lost-step = Remote audio is paused. Reconnect them or pick another output in Settings.
notice-mic-title = The microphone is not available
notice-mic-step = Check that Relay may use it and that no other app is holding it, then try again.
notice-avatar-title = A profile picture was not accepted
notice-avatar-step = Nothing else is affected.
notice-prefs-recovered-title = Your settings were repaired
notice-prefs-recovered-step = A backup was used. Check your microphone choice in Settings.
notice-prefs-reset-title = Your settings were reset
notice-prefs-reset-step = Choose your microphone again in Settings.
notice-trust-recovered-title = Some trusted devices may need checking again
notice-trust-recovered-step = The list of trusted devices was repaired. Verify recent contacts again from Contacts.
notice-trust-lost-title = Your list of trusted devices was lost
notice-trust-lost-step = Verify each device again from Contacts.
