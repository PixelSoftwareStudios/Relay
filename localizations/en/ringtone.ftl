# Relay desktop UI catalog, English (en), section: Ringtone (choose, reset and preview the incoming-call ring). Same ids and $variables as localizations/en/ringtone.ftl. See docs/i18n.md.

ringtone-title = Ringtone
ringtone-default-name = Built-in chime
ringtone-current = Current ringtone: { $name }
ringtone-busy = Preparing the ringtone…
ringtone-choose = Choose file…
ringtone-choose-hover = Pick an audio file (MP3, Ogg, FLAC, WAV or AAC) to ring with on this device.
ringtone-reset = Use built-in chime
ringtone-help = The ringtone plays on this device only. The file is copied into the app and is never sent to anyone. Its size and length limits are under Storage and limits.
ringtone-err-empty = That file is empty.
ringtone-err-too-large = That file is too big to be a ringtone. Choose a smaller one, or raise the limit under Storage and limits.
ringtone-err-too-long = That sound is too long to be a ringtone. Choose a shorter one, or raise the limit under Storage and limits.
ringtone-err-too-short = That sound is too short to be a ringtone.
ringtone-err-unsupported = Relay cannot play that kind of file. Use MP3, Ogg Vorbis, FLAC, WAV or AAC.
ringtone-err-corrupt = That file could not be read as audio. It may be damaged.
ringtone-err-silent = That file is silent.
ringtone-err-no-picker = This device cannot choose a ringtone file.
dialog-ringtone = Choose a ringtone
dialog-audio-filter = Audio files
