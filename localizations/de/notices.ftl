# Relay desktop UI catalog, German (de), section: Notices strip.
# Same ids and $variables as localizations/en/notices.ftl. See docs/i18n.md.

notice-dismiss-all = Alle schließen
notice-more = +{ $count } weitere
notice-fewer = Weniger anzeigen
notice-repeated = { $title } ({ $count }-mal)
notice-key-changed-title = Der Sicherheitsschlüssel von { $name } hat sich geändert
notice-key-changed-title-unnamed = Der Sicherheitsschlüssel eines Geräts hat sich geändert
notice-key-changed-step = Das passiert meist nach einer Neuinstallation oder einem Zurücksetzen von Relay auf diesem Gerät. Du kannst es unter „Kontakte“ erneut verifizieren.
notice-audio-restarted-title = Audio wurde kurz unterbrochen und neu gestartet.
notice-audio-restarted-step = Klingt ein Anruf seltsam, leg auf und ruf erneut an.
notice-audio-failed-title = Audio funktioniert nicht mehr und ließ sich nicht neu starten.
notice-audio-failed-step = Starte Relay neu.
notice-mic-restarted-title = Dein Mikrofon ist ausgefallen.
notice-render-restarted-title = Der Ton der Gegenseite ist ausgefallen.
notice-worker-restarted-step = Relay hat es neu gestartet.
notice-output-lost-title = Lautsprecher oder Kopfhörer wurden getrennt
notice-output-lost-step = Der Ton der Gegenseite ist pausiert. Schließe sie wieder an oder wähle in den Einstellungen eine andere Ausgabe.
notice-mic-title = Das Mikrofon ist nicht verfügbar
notice-mic-step = Prüfe, ob Relay es nutzen darf und keine andere App es belegt, und versuche es dann erneut.
notice-avatar-title = Ein Profilbild wurde nicht angenommen
notice-avatar-step = Alles andere funktioniert weiter.
notice-prefs-recovered-title = Deine Einstellungen wurden repariert
notice-prefs-recovered-step = Eine Sicherung wurde verwendet. Prüfe deine Mikrofonauswahl in den Einstellungen.
notice-prefs-reset-title = Deine Einstellungen wurden zurückgesetzt
notice-prefs-reset-step = Wähle dein Mikrofon in den Einstellungen erneut aus.
notice-trust-recovered-title = Einige vertraute Geräte müssen eventuell erneut verifiziert werden
notice-trust-recovered-step = Die Liste der vertrauten Geräte wurde repariert. Verifiziere kürzlich hinzugefügte Kontakte unter „Kontakte“ erneut.
notice-trust-lost-title = Deine Liste vertrauter Geräte ging verloren
notice-trust-lost-step = Verifiziere jedes Gerät unter „Kontakte“ erneut.
