revoke-keep = Behalten
revoke-from = Aus { $channel } entfernen
home-nearby = In der Nähe
people-none-nearby = Im Netzwerk wurden noch keine Geräte gefunden.
people-none-nearby-help = Beide Geräte müssen im selben WLAN sein und Relay muss geöffnet sein. Erlaube Relay den Zugriff auf das lokale Netzwerk, falls dein System danach fragt. Manche Router verhindern, dass Geräte einander sehen (Client-Isolation oder Gastnetz). Hilft das alles nicht, nutze unten „Gerät verbinden“.
people-add-title = Gerät über Adresse hinzufügen
people-add-help = Füge die Adresse ein, die das andere Gerät unter „Gerät verbinden“ anzeigt.
peer-call-blocked = Dieses Gerät kann gerade nicht angerufen werden.
peer-no-key = Für dieses Gerät wurde noch kein Schlüssel gesehen.
peer-key-help = Vergleiche diesen Schlüssel mit dem auf dem anderen Gerät, um sicher zu sein, mit wem du sprichst.
forget-device = Dieses Gerät vergessen
forget-ask = { $name } vergessen? Dem Gerät wird dann nicht mehr vertraut.
forget-yes = Ja, vergessen
sidebar-you = Du
connect-title = Gerät verbinden
visibility-discoverable = Auffindbar
visibility-discoverable-help = Geräte im selben Netzwerk können dieses Gerät sehen und anrufen.
visibility-private = Privat
visibility-private-help = Dieses Gerät ist im Netzwerk verborgen. Nur wer deine Adresse hat, kann dich anrufen.
visibility-not-advertising = Nicht auffindbar
visibility-not-advertising-reason = Nicht auffindbar: { $reason }
visibility-go-private = Privat schalten
visibility-go-discoverable = Auffindbar machen
people-found-help = Diese Geräte sind in deinem Netzwerk, aber du vertraust ihnen noch nicht. Vertraue einem Gerät erst, wenn du geprüft hast, wer es ist.
found-trust = Diesem Gerät vertrauen
found-trust-ask = Bevor du { $name } vertraust, vergleiche diesen Fingerabdruck mit dem auf dem Gerät angezeigten („Gerät verbinden“, dann „Details“). Vertraue nur, wenn beide gleich sind.
found-trust-yes = Ja, vertrauen
found-trust-cancel = Jetzt nicht
found-subtitle = Noch nicht vertraut · { $fingerprint }
contacts-empty-title = Noch keine Kontakte
contacts-empty-help = Ein Kontakt ist ein Gerät, dem du vertraust. Finde eines unter „Verbinden“ und vertraue ihm, dann erscheint es hier.
contacts-go-connect = Zu „Verbinden“
contact-more = Weitere Optionen
peer-addresses = Adressen: { $addresses }
contact-last-seen = Zuletzt gesehen: { $when }
peer-port = Port { $port }
contact-favorite-add = Zu Favoriten hinzufügen
contact-favorite-remove = Aus Favoriten entfernen

# Schlüssel geändert: ein vertrauenswürdiges Gerät zeigt einen anderen Sicherheitsschlüssel.
contact-key-changed-label = Sicherheitsschlüssel geändert
keychange-title = Der Sicherheitsschlüssel von { $name } hat sich geändert
keychange-body = Das passiert meist, wenn Relay auf diesem Gerät neu installiert oder zurückgesetzt wurde. Anrufe sind gesperrt, bis du das Gerät erneut verifizierst.
keychange-scan = QR-Code des Geräts scannen
keychange-compare = Vergleichen und neuem Schlüssel vertrauen
keychange-remove = Kontakt entfernen
keychange-remove-ask = { $name } aus deinen Kontakten entfernen? Dem Gerät wird dann nicht mehr vertraut.
keychange-remove-yes = Ja, entfernen
keychange-compare-intro = Öffne auf { $name } „Verbinden“, dann „Gerät verbinden“, dann „Details“. Gib den dort angezeigten Fingerabdruck ein oder füge ihn ein. Vertraue dem neuen Schlüssel nur, wenn beide gleich sind.
keychange-new-key = Neuer Schlüssel dieses Geräts
keychange-field-hint = Fingerabdruck vom anderen Gerät
keychange-match = Sie stimmen überein.
keychange-no-match = Die Zeichen stimmen noch nicht überein.
keychange-confirm = Neuem Schlüssel vertrauen
keychange-cancel = Jetzt nicht
keychange-previous = Bisheriger Schlüssel { $fingerprint }
found-call-help = Rufst du ein Gerät in der Nähe an, wird es nach dem Annehmen als unverifiziert zu deinen Kontakten hinzugefügt. Um vorher den Fingerabdruck zu vergleichen, nutze „Diesem Gerät vertrauen“.
block-device = Gerät blockieren
block-ask = { $name } blockieren? Das Gerät kann dich nicht mehr anrufen oder sehen und wird aus den Kontakten entfernt. In den Einstellungen kannst du es wieder freigeben.
block-yes = Blockieren
unblock = Freigeben
