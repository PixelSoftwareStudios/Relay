# Relay desktop UI catalog, Portuguese (Brazil) (pt-BR), section: People nearby.
# Tradução para o português do Brasil; ids e $variáveis iguais aos do inglês.

peer-unknown = Dispositivo desconhecido
peer-online = Online
peer-unreachable = Offline
peer-key = Chave { $fingerprint }
peer-shared-channels = Canais em comum: { $names }
peer-call = Ligar
revoke-ask = Remover { $name } de { $channel }?
revoke-yes = Sim, revogar
revoke-keep = Manter
revoke-from = Revogar de { $channel }
home-nearby = Por perto
people-none-nearby = Nenhum dispositivo encontrado nesta rede ainda.
people-none-nearby-help = Os dois dispositivos precisam estar no mesmo Wi-Fi com o Relay aberto. Permita o acesso à rede local ao Relay se o sistema perguntar. Alguns roteadores impedem que os dispositivos se vejam (isolamento de clientes ou rede de convidados). Se nada ajudar, use Conectar um dispositivo abaixo.
people-add-title = Adicionar um dispositivo pelo endereço
people-add-help = Cole o endereço mostrado em Conectar um dispositivo no outro dispositivo.
peer-call-blocked = Não é possível ligar para este dispositivo agora.
peer-no-key = Nenhuma chave foi vista para este dispositivo ainda.
peer-key-help = Compare esta chave com a do outro dispositivo para ter certeza de com quem fala.
forget-device = Esquecer este dispositivo
forget-ask = Esquecer { $name }? Ele deixará de ser confiável.
forget-yes = Sim, esquecer
sidebar-you = Você
connect-title = Conectar um dispositivo
visibility-discoverable = Detectável
visibility-discoverable-help = Dispositivos na mesma rede podem ver este aparelho e ligar para ele.
visibility-private = Privado
visibility-private-help = Este dispositivo está oculto na rede. Só quem tem o seu endereço pode ligar para você.
visibility-not-advertising = Sem divulgação
visibility-not-advertising-reason = Sem divulgação: { $reason }
visibility-go-private = Tornar privado
visibility-go-discoverable = Tornar detectável
people-found-help = Estes dispositivos estão na sua rede, mas você ainda não confia neles. Confie em um só depois de verificar quem é.
found-trust = Confiar neste dispositivo
found-trust-ask = Antes de confiar em { $name }, compare esta impressão digital com a mostrada nesse dispositivo (Conectar um dispositivo, depois Detalhes). Confie só se forem iguais.
found-trust-yes = Sim, confiar
found-trust-cancel = Agora não
found-subtitle = Ainda sem confiança · { $fingerprint }
contacts-empty-title = Nenhum contato ainda
contacts-empty-help = Um contato é um dispositivo em que você confiou. Encontre um em Conectar e confie nele; depois ele aparece aqui.
contacts-go-connect = Ir para Conectar
contact-more = Mais opções
peer-addresses = Endereços: { $addresses }
contact-last-seen = Visto por último: { $when }
peer-port = Porta { $port }
contact-favorite-add = Adicionar aos favoritos
contact-favorite-remove = Remover dos favoritos

# Chave alterada: um dispositivo confiável mostra outra chave de segurança.
contact-key-changed-label = A chave de segurança mudou
keychange-title = A chave de segurança de { $name } mudou
keychange-body = Isso costuma acontecer depois que o Relay foi reinstalado ou redefinido nesse dispositivo. As chamadas ficam bloqueadas até você verificar de novo.
keychange-scan = Ler o código QR dele
keychange-compare = Comparar e confiar na nova chave
keychange-remove = Remover contato
keychange-remove-ask = Remover { $name } dos seus contatos? Ele deixará de ser confiável.
keychange-remove-yes = Sim, remover
keychange-compare-intro = Em { $name }, abra Conectar, depois Conectar um dispositivo e Detalhes. Digite ou cole a impressão digital mostrada lá. Confie na nova chave somente se as duas forem iguais.
keychange-new-key = Chave nova vista por este dispositivo
keychange-field-hint = Impressão digital do outro dispositivo
keychange-match = Elas são iguais.
keychange-no-match = Esses dígitos ainda não são iguais.
keychange-confirm = Confiar na nova chave
keychange-cancel = Agora não
keychange-previous = Chave anterior { $fingerprint }
found-call-help = Ligar para um dispositivo próximo o adiciona aos Contatos como não verificado quando ele atender. Para comparar antes a impressão digital, use Confiar neste dispositivo.
block-device = Bloquear dispositivo
block-ask = Bloquear { $name }? Ele não poderá mais ligar nem ver você, e sai dos Contatos. Você pode desbloquear em Configurações.
block-yes = Bloquear
unblock = Desbloquear
peer-call-offline = Este dispositivo está offline. Você poderá ligar para ele assim que voltar à rede.
