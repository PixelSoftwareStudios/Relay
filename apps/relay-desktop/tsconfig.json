{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["svelte", "vite/client"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"paths": { "$assets/*": ["../../assets/*"] }
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}
