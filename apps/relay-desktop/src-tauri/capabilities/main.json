{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "Main window: events plus the restricted Relay command set only.",
	"windows": [
		"main"
	],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-get-state",
		"allow-get-meters",
		"allow-start-call",
		"allow-accept-call",
		"allow-decline-call",
		"allow-end-call",
		"allow-set-transmit",
		"allow-set-call-controls",
		"allow-set-global-controls",
		"allow-select-devices",
		"allow-set-profile",
		"allow-upload-avatar",
		"allow-hide-window",
		"allow-quit-app"
	]
}
